# =============================================================
# .env.example — MODELO de configuração
#
# Este arquivo VAI para o Git. Ele documenta QUAIS variáveis o
# projeto precisa, sem revelar NENHUM valor real.
#
# Como usar (PowerShell, na raiz do projeto):
#     Copy-Item .env.example .env
# Depois preencha o .env com os valores reais.
# O .env está no .gitignore e nunca será versionado.
# =============================================================

# -------------------------------------------------------------
# RIOT API
# -------------------------------------------------------------
# Gere em https://developer.riotgames.com
# A chave de desenvolvimento EXPIRA A CADA 24 HORAS.
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# Roteamento de PLATAFORMA — usado por league-v4 e summoner-v4
# (endpoints que falam de contas e ranking)
RIOT_PLATFORM=br1

# Roteamento de REGIÃO — usado por match-v5 e account-v1
# (endpoints que falam de partidas). br1 pertence a "americas".
RIOT_REGION=americas

# -------------------------------------------------------------
# POSTGRESQL
# -------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=lol_analytics
PGUSER=postgres
PGPASSWORD=coloque_sua_senha_aqui

# -------------------------------------------------------------
# PARÂMETROS DE COLETA
# Vêm direto do charter (docs/ETAPA-01-planejamento.md, seção 1.2).
# Ficam aqui, e não espalhados pelo código, para que mudar o
# escopo do projeto não exija reescrever nenhum script.
# -------------------------------------------------------------
QUEUE_ID=420
TIERS=MASTER,GRANDMASTER,CHALLENGER
TARGET_MATCHES=5000
COLLECTION_DAYS=30
